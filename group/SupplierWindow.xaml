<Window x:Class="group.NhaCungCap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Nhà Cung Cấp" Height="450" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--khung nhập thông tin-->
        <GroupBox Grid.Column="0">
            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- Mã NCC -->
                <Label Content="Mã NCC:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtMaNCC" Grid.Row="0" Grid.Column="1" Height="25"/>

                <!-- Tên NCC -->
                <Label Content="Tên NCC:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txtTenNCC" Grid.Row="0" Grid.Column="3" Height="25"/>

                <!-- SĐT -->
                <Label Content="SĐT:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSDT" Grid.Row="1" Grid.Column="1" Height="25"/>

                <!-- Email -->
                <Label Content="Email:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txtEmail" Grid.Row="1" Grid.Column="3" Height="25"/>

                <!-- Địa chỉ -->
                <Label Content="Địa chỉ:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtDiaChi" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="25"/>


                
            </Grid>
        </GroupBox>
        <!--khung nhập buttom-->

        <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                <Button Content="Thêm" Width="80" Margin="5" Click="BtnThem_Click"/>
                <Button Content="Sửa" Width="80" Margin="5" Click="BtnSua_Click"/>
                <Button Content="Xóa" Width="80" Margin="5" Click="BtnXoa_Click"/>
                <Button Content="Tìm kiếm" Width="80" Margin="5" Click="BtnTimKiem_Click" Name="btn_timKiem"/>
                <Button Content="Thoát"
                Width="80"
                Margin="5"
                Click="BtnThoat_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Bảng hiển thị danh sách NCC -->    
        <DataGrid x:Name="dgNCC"
          SelectionChanged="dgNCC_SelectionChanged"
          AutoGenerateColumns="True"
          Margin="0,10,0,0" Grid.Row="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã NCC" Binding="{Binding MaNCC}" Width="100"/>
                <DataGridTextColumn Header="Tên NCC" Binding="{Binding TenNCC}" Width="150"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding DienThoai}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>