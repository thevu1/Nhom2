<Window x:Class="group.QuenMatKhau"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quên mật khẩu" Height="220" Width="400">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nhập Email hoặc Username -->
        <StackPanel Orientation="Horizontal" Margin="0,10" Grid.Row="0">
            <Label Content="Email/Tên đăng nhập:" Width="150"/>
            <TextBox x:Name="txtEmailOrUser" Width="200"/>
        </StackPanel>

        <!-- Nút chức năng -->
        <StackPanel Orientation="Horizontal" Margin="0,20" Grid.Row="1" HorizontalAlignment="Center">
            <Button Content="Gửi yêu cầu" Width="120" Margin="10" Click="BtnSend_Click"/>
            <Button Content="Thoát" Width="80" Margin="10" Click="BtnExit_Click"/>
        </StackPanel>

        <!-- Thông báo -->
        <TextBlock x:Name="lblMessage" Grid.Row="2" 
                   Foreground="Red" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,10"/>
    </Grid>
</Window>