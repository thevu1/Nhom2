<Window x:Class="group.TrangChu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ thống quản lý kho"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <!-- STYLE MENU -->
    <Window.Resources>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- CHIA LAYOUT -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- SIDEBAR -->
        <Border Background="#0F172A" Grid.Column="0">
            <StackPanel>

                <TextBlock Text="QUẢN LÝ KHO"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="15"/>

                <Separator Margin="10" Background="#1E293B"/>

                <Button Content="📦 Sản phẩm"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="📊 Tồn kho"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="📥 Phiếu nhập"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="📤 Phiếu xuất"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="🛠 Quản lý sản phẩm"
                        Style="{StaticResource MenuButtonStyle}"/>

            </StackPanel>
        </Border>



        <!-- KHU VỰC CHÍNH -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- KHUNG TẠO DANH MỤC -->
            <Border Background="White"
        Margin="10"
        Padding="15"
        CornerRadius="10"
        Grid.Row="0">

                <Grid>

                    <!-- CHIA CỘT RESPONSIVE -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LABEL -->
                    <TextBlock Grid.Column="0"
                   Text="Tạo danh mục:"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   Margin="0,0,10,0"/>

                    <!-- TÊN DANH MỤC -->
                    <TextBox x:Name="txtTenHangMuc"
                 Grid.Column="1"
                 Height="35"
                 Margin="5"
                 VerticalContentAlignment="Center"/>

                    <!-- HÌNH ẢNH -->
                    <TextBox x:Name="txtHinhAnh"
                 Grid.Column="2"
                 Height="35"
                 Margin="5"
                 VerticalContentAlignment="Center"/>

                    <!-- NÚT CHỌN ẢNH -->
                    <Button Grid.Column="3"
                Content="Chọn ảnh"
                Height="35"
                Margin="5"
                Click="BtnChonAnh_Click"/>

                    <!-- NÚT THÊM -->
                    <Button Grid.Column="4"
                Content="➕ Thêm"
                Height="35"
                Margin="5"
                Background="#0F172A"
                Foreground="White"
                Click="BtnThemSP_Click"/>

                    <!-- NÚT BACK GÓC PHẢI DƯỚI -->
                    
                </Grid>
            </Border>
            
            <!-- DANH SÁCH DANH MỤC / SẢN PHẨM -->
            <GroupBox Grid.Row="1">
                <Grid>
                <ScrollViewer >

                    <WrapPanel x:Name="WrapPanelProducts"
                           Margin="10"
                           ItemWidth="180"
                           ItemHeight="200"/>

                </ScrollViewer>
                    <Button x:Name="btnBack"
            Content="← Trang chủ"
            Width="140"
            Height="40"
            Margin="20"
            Background="#64748B"
            Foreground="White"
            Visibility="Collapsed"
            Click="BtnBack_Click"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="10"/>
                </Grid>
            </GroupBox>
            

        </Grid>

    </Grid>
</Window>