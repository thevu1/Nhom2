<Window x:Class="group.DoiMaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mã xác minh" Height="250" Width="350">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Mã cũ -->
        <Label Content="Mã cũ:" Grid.Row="0"/>
        <PasswordBox x:Name="txtOld" Grid.Row="1"/>

        <!-- Mã mới -->
        <Label Content="Mã mới:" Grid.Row="2"/>
        <PasswordBox x:Name="txtNew" Grid.Row="3"/>

        <!-- Button -->
        <Button Content="Đổi mã"
                Grid.Row="4"
                Height="35"
                Margin="0,10,0,0"
                Click="BtnDoi_Click"/>

    </Grid>
</Window>