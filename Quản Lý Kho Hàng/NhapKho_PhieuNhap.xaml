<Window x:Class="Quản_Lý_Kho_Hàng.NhapKho_PhieuNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quản_Lý_Kho_Hàng"
        mc:Ignorable="d"
        Title="NHẬP KHO - PHIẾU NHẬP"
        Width="980" Height="650"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20" MaxWidth="1100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                
                <RowDefinition Height="Auto"/>
                
                <RowDefinition Height="Auto"/>
               
                <RowDefinition Height="Auto"/>
                
            </Grid.RowDefinitions>

            
            <Border Grid.Row="0"
                    Background="#F5F5F5"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,14">
                <TextBlock Text="NHẬP KHO - PHIẾU NHẬP"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

           
            <GroupBox Grid.Row="1" Header="Thông tin phiếu nhập" Margin="0,0,0,14">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                   
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mã phiếu:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="txtMaPN"
                                     Height="32" VerticalContentAlignment="Center"
                                     IsReadOnly="True"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nhà cung cấp:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="cboNCC" Height="32"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Người nhập:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="cboNguoiNhap" Height="32"/>
                        </Grid>
                    </Grid>

                    <!-- Cột phải -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ngày nhập:" VerticalAlignment="Center"/>
                            <DatePicker Grid.Column="1" x:Name="dpNgayNhap" Height="32"/>
                        </Grid>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Ghi chú:" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtGhiChu"
                                     Height="70"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>

           
            <GroupBox Grid.Row="2" Header="Chi tiết phiếu nhập" Margin="0,0,0,14">
                <Grid Margin="14">
                    <Border BorderBrush="#DDD"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*"/>

                                <ColumnDefinition Width="16"/>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>

                                <ColumnDefinition Width="16"/>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>

                                <ColumnDefinition Width="16"/>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>

                                <ColumnDefinition Width="16"/>

                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            
                            <TextBlock Grid.Column="0" Text="Sản phẩm:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="cboSanPham" Height="32" MinWidth="220"/>

                            
                            <TextBlock Grid.Column="3" Text="SL:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="4" x:Name="txtSoLuong" Height="32" MinWidth="70"/>

                            
                            <TextBlock Grid.Column="6" Text="Đơn giá:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="7" x:Name="txtDonGia" Height="32" MinWidth="100"/>
 
                            <TextBlock Grid.Column="9" Text="TT:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="10" x:Name="txtThanhTien" Height="32" IsReadOnly="True" MinWidth="120"/>

                            
                            <StackPanel Grid.Column="12" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnThem" Content="Thêm" Width="80" Height="34" Margin="0,0,8,0"/>
                                <Button x:Name="btnXoa" Content="Xóa" Width="80" Height="34"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </GroupBox>

            
            <Border Grid.Row="3"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Tổng tiền:"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1"
                             x:Name="txtTongTien"
                             Height="34"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnTaoMoi" Content="Tạo mới" Width="90" Height="36" Margin="0,0,8,0"/>
                        <Button x:Name="btnLuuPhieu" Content="Lưu phiếu" Width="90" Height="36" Margin="0,0,8,0"/>
                        <Button x:Name="btnIn" Content="In" Width="70" Height="36" Margin="0,0,8,0"/>
                        <Button x:Name="btnThoat" Content="Thoát" Width="80" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Window>
