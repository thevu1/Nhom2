<Window x:Class="WpfApp_QuanLySanPham.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_QuanLySanPham"
        mc:Ignorable="d"
        Title="Quản lý sản phẩm" Height="550" Width="750"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nhập liệu -->
        <GroupBox Margin="10" Header="Nhập liệu" Grid.Column="0">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Mã sản phẩm:" Grid.Column="0" Grid.Row="0" Margin="3"/>
                <TextBox x:Name="txtMaSP" Grid.Column="1" Grid.Row="0" Margin="3"/>

                <Label Content="Tên sản phẩm:" Grid.Column="0" Grid.Row="1" Margin="3"/>
                <TextBox x:Name="txtTenSP" Grid.Column="1" Grid.Row="1" Margin="3"/>

                <Label Content="Ngày nhập:" Grid.Column="0" Grid.Row="2" Margin="3"/>
                <DatePicker x:Name="dpNgayNhap" Grid.Column="1" Grid.Row="2" Margin="3"/>

                <Label Content="Giá nhập:" Grid.Column="0" Grid.Row="3" Margin="3"/>
                <TextBox x:Name="txtGiaNhap" Grid.Column="1" Grid.Row="3" Margin="3"/>

                <Label Content="Giá bán:" Grid.Column="0" Grid.Row="4" Margin="3"/>
                <TextBox x:Name="txtGiaBan" Grid.Column="1" Grid.Row="4" Margin="3"/>

                <Label Content="Đơn vị tính:" Grid.Column="0" Grid.Row="5" Margin="3"/>
                <ComboBox x:Name="cboDonVi" Grid.Column="1" Grid.Row="5" Margin="3" IsEditable="True"/>
            </Grid>
        </GroupBox>

        <!-- Chức năng -->
        <GroupBox Margin="10" Header="Chức năng" Grid.Column="1">
            <StackPanel Margin="10" VerticalAlignment="Center">
                <!-- Ô nhập từ khóa tìm kiếm -->
                <TextBox x:Name="txtTuKhoa" Margin="5" Padding="5" ToolTip="Nhập từ khóa tìm kiếm (mã hoặc tên)"/>
                <Button Content="Tìm kiếm" x:Name="btnTimKiem" Margin="5" Padding="10,5" Click="btnTimKiem_Click"/>
                <Button Content="Thêm" x:Name="btnThem" Margin="5" Padding="10,5" Click="btnThem_Click"/>
                <Button Content="Sửa" x:Name="btnSua" Margin="5" Padding="10,5" Click="btnSua_Click"/>
                <Button Content="Xóa" x:Name="btnXoa" Margin="5" Padding="10,5" Click="btnXoa_Click"/>
                <Button Content="Làm mới" x:Name="btnLamMoi" Margin="5" Padding="10,5" Click="btnLamMoi_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Danh sách sản phẩm -->
        <GroupBox Margin="10" Header="Danh sách sản phẩm" Grid.Row="1" Grid.ColumnSpan="2">
            <DataGrid x:Name="dgProducts" AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionMode="Single" SelectionUnit="FullRow" Margin="5"
                      MouseDoubleClick="dgProducts_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SP" Binding="{Binding MSP}" Width="*"/>
                    <DataGridTextColumn Header="Tên SP" Binding="{Binding TENSP}" Width="*"/>
                    <DataGridTextColumn Header="Ngày nhập" Binding="{Binding NgayNhap, StringFormat=dd/MM/yyyy}" Width="*"/>
                    <DataGridTextColumn Header="Giá nhập" Binding="{Binding GiaNhap, StringFormat=N0}" Width="*"/>
                    <DataGridTextColumn Header="Giá bán" Binding="{Binding GiaBan, StringFormat=N0}" Width="*"/>
                    <DataGridTextColumn Header="Đơn vị" Binding="{Binding Donvi}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>