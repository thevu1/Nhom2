<Window x:Class="xuatKhoMoi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phiếu Xuất Kho" Height="520" Width="900">

    <Window.Resources>

        <!-- Placeholder style -->
        <Style x:Key="PlaceholderTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="5"/>

            <Style.Triggers>

                <!-- Text rỗng -->
                <Trigger Property="Text" Value="">
                    <Setter Property="Foreground" Value="Gray"/>
                </Trigger>

                <!-- Khi focus -->
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>

            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= THÔNG TIN PHIẾU ================= -->
        <GroupBox Header="Thông Tin Phiếu">
            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Mã phiếu" Margin="5"/>
                <TextBox x:Name="txt_maPhieuXuat"
                         Grid.Column="1"
                         Margin="5"/>

                <Label Content="Ngày Xuất"
                       Grid.Column="2"
                       Margin="5"/>

                <DatePicker x:Name="dp_ngayXuat"
                            Grid.Column="3"
                            Margin="5"/>

                <Label Content="Ghi Chú"
                       Grid.Row="1"
                       Margin="5"/>

                <TextBox x:Name="txt_ghiChu"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Margin="5"/>
            </Grid>
        </GroupBox>

        <!-- ================= CHI TIẾT ================= -->
        <GroupBox Header="Chi Tiết"
                  Grid.Row="1"
                  Margin="0,10,0,10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== INPUT ROW (đã cân layout chuẩn) ===== -->
                <Grid Margin="5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SẢN PHẨM -->
                    <ComboBox x:Name="comboBox_sanPham"
                                Grid.Column="0"
                                Height="30"
                                Margin="5"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">

                        <ComboBox.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </ComboBox.Resources>
                    </ComboBox>

                    <!-- SỐ LƯỢNG -->
                    <TextBox x:Name="txt_soLuong"
                             Grid.Column="1"
                             Height="30"
                             Margin="5"
                             Text="Số lượng"
                             VerticalContentAlignment="Center"
                             GotFocus="txt_soLuong_GotFocus"
                             LostFocus="txt_soLuong_LostFocus"
                             Style="{StaticResource PlaceholderTextBox}"/>

                    <!-- ĐƠN GIÁ -->
                    <TextBox x:Name="txt_donGia"
                             Grid.Column="2"
                             Height="30"
                             Margin="5"
                             Text="Đơn giá"
                             VerticalContentAlignment="Center"
                             GotFocus="txt_donGia_GotFocus"
                             LostFocus="txt_donGia_LostFocus"
                             Style="{StaticResource PlaceholderTextBox}"/>

                    <!-- BUTTON -->
                    <Button Content="Thêm"
                            Grid.Column="3"
                            Height="30"
                            Width="100"
                            Margin="5"
                            Click="bt_themSanPham_Click"/>
                </Grid>

                <!-- ===== DATA GRID ===== -->
                <DataGrid x:Name="dg_chiTiet"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          Margin="5">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên Sản Phẩm"
                                            Binding="{Binding TenSP}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Số Lượng"
                                            Binding="{Binding SoLuong}"/>

                        <DataGridTextColumn Header="Đơn Giá"
                                            Binding="{Binding DonGia}"/>

                        <DataGridTextColumn Header="Thành Tiền"
                                            Binding="{Binding ThanhTien}"/>
                    </DataGrid.Columns>

                </DataGrid>

                <!-- ===== TỔNG ===== -->
                <StackPanel Orientation="Horizontal"
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Margin="5">

                    <Label Content="Tổng:" FontWeight="Bold"/>

                    <TextBlock x:Name="txt_tongTien"
                               Width="150"
                               TextAlignment="Right"
                               FontWeight="Bold"/>
                </StackPanel>

            </Grid>
        </GroupBox>

        <!-- ================= BUTTON ================= -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="Tạo Mới"
                    Width="100"
                    Margin="5"
                    Click="bt_taoMoi_Click"/>

            <Button Content="Lưu"
                    Width="100"
                    Margin="5"
                    Click="bt_luu_Click"/>

            <Button Content="Thoát"
                    Width="100"
                    Margin="5"
                    Click="bt_thoat_Click"/>
        </StackPanel>

    </Grid>
</Window>